    <!-- 关于界面 -->
    <string name="settings_about_eyebrow">关于</string>
    <string name="settings_about_title">Lagrange Reader</string>
    <string name="settings_about_intro">一款独立的 Android 应用，用于阅读和收听托管在 BookOrbit 上的图书。</string>
    <string name="settings_about_description">Lagrange 是独立的原生 Android 客户端，并非 BookOrbit 网页界面的封装。BookOrbit 提供经过身份验证的服务器和书库数据；Lagrange 提供 Android 界面、本地状态、阅读、收听和离线功能。</string>
