    <!-- About screen -->
    <string name="settings_about_eyebrow">About</string>
    <string name="settings_about_title">Lagrange Reader</string>
    <string name="settings_about_intro">An independent Android app for reading and listening to books hosted on BookOrbit.</string>
    <string name="settings_about_description">Lagrange is a standalone native Android client, not a wrapper around the BookOrbit web interface. BookOrbit supplies the authenticated server and library data; Lagrange provides the Android interface, local state, reading, listening, and offline behavior.</string>
